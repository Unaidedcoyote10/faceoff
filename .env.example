# Copy to .env next to docker-compose.yml and adjust. All values here are examples.
FACEOFF_PORT=8088
TZ=UTC

# Where processed (blurred / boxed) photos are written on the host. Quote paths with spaces.
EXPORT_HOST_DIR="./export"
# Optional: how the export folder is shown in the UI (e.g. the network-share path your other devices see).
# EXPORT_LABEL='\\nas\Photos\Faceoff'

# Private app data (originals, previews, SQLite DB). Keep it off any shared folder.
DATA_HOST_DIR=./data

# User/group the container runs as; exported files are written 664, folders 775.
PUID=1000
PGID=1000
# UMASK=002
# EXPORT_FILE_MODE=664

# Processing
WORKERS=2
CV_THREADS=2
# DEFAULT_MODE=blur            # blur | box
# DEFAULT_PADDING=0.08
# DEFAULT_SENSITIVITY=medium   # low | medium | high
# MEM_LIMIT=1g

# Optional HTTP basic auth (recommended if Faceoff is reachable beyond your own machine / private network)
# APP_PASSWORD=change-me
# APP_USER=

# Optional: copy raw Instagram saves from the Faceoff Sync extension to their own folder
# IG_EXPORT_ENABLED=1
# IG_EXPORT_HOST_DIR="./export-ig"
# IG_EXPORT_LABEL='\\nas\Photos\Instagram Saves'
